# CampusCare AI service settings (all optional). Export them in your shell, or put them in your process manager.

# Where the trained models live (relative to this folder)
MODEL_DIR=models

# Train automatically on first start, or when scikit-learn was upgraded (takes ~20 s)
AUTO_TRAIN=1
DATA_FILE=data/campus_issues.csv

# Category model: auto (BERT if models/bert-category exists and torch is installed, else TF-IDF) | tfidf | bert
CLASSIFIER=auto

# Embeddings for duplicate detection: auto (Sentence-BERT if installed, else LSA) | sbert | lsa
EMBEDDER=auto
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Server
HOST=127.0.0.1
PORT=8001
